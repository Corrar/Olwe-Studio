# Chave da API do TMDB (v3 "API Key" ou v4 "Read Access Token").
# Sem ela, o Olwe usa um catálogo de demonstração com títulos fictícios.
TMDB_API_KEY=

# Segredo para assinar a sessão. Gere com: openssl rand -base64 32
SESSION_SECRET=

# Banco de dados (libSQL). Local: file:./data/olwe.db  ·  Produção: libsql://<seu-db>.turso.io
DATABASE_URL=file:./data/olwe.db
DATABASE_AUTH_TOKEN=

# Opcional: URL de um arquivo de vídeo (MP4/HLS) tocado no player no lugar do trailer.
DEMO_VIDEO_URL=

# E-mails de confirmação de cadastro e de troca de senha. Sem nenhum provedor, as contas novas
# entram sem confirmação e não há "Esqueceu a senha?".
#
# Opção grátis e sem domínio: uma conta do Gmail com senha de app (até ~500 e-mails por dia).
# Ative a verificação em duas etapas na conta e crie a senha em https://myaccount.google.com/apppasswords
SMTP_USER=
SMTP_PASS=
# Outro servidor SMTP (padrão: smtp.gmail.com, porta 465).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# Remetente (padrão: "Olwe" <SMTP_USER>). O Gmail só aceita o próprio endereço da conta.
# SMTP_FROM=

# Ou pelo Resend (https://resend.com/api-keys). O SMTP tem prioridade quando os dois estão configurados.
RESEND_API_KEY=
# Remetente de um domínio verificado no Resend. Sem ele, o Resend só entrega para o dono da conta,
# e por isso o Olwe publicado na Vercel não liga a confirmação só com a RESEND_API_KEY.
RESEND_FROM=
# Cota diária de e-mails do Olwe (padrão 90).
# EMAIL_DAILY_LIMIT=90
# Endereço público usado nos links dos e-mails (na Vercel, o domínio de produção é detectado sozinho).
APP_URL=

# Olwe Premium (sem anúncios) pelo Mercado Pago: https://www.mercadopago.com.br/developers/panel/app
# Access Token da aplicação (use o de teste, TEST-..., até liberar as vendas). Sem ele, não há venda.
MERCADOPAGO_ACCESS_TOKEN=
# Assinatura secreta dos webhooks (painel do Mercado Pago > Webhooks). Recomendado em produção.
MERCADOPAGO_WEBHOOK_SECRET=
# Preço mensal do Premium em reais (padrão 9.90).
PREMIUM_PRICE=9.90

# Anúncios do Olwe Grátis: tag VAST da rede de anúncios (Google Ad Manager, etc.), em HTTPS.
# Vazio = ninguém vê anúncio. Perfis infantis e assinantes Premium nunca veem.
# Para testar, a tag de exemplo do Google:
# https://pubads.g.doubleclick.net/gampad/ads?iu=/21775744923/external/single_ad_samples&sz=640x480&cust_params=sample_ct%3Dlinear&ciu_szs=300x250%2C728x90&gdfp_req=1&output=vast&unviewed_position_start=1&env=vp&impl=s&correlator=
AD_TAG_URL=

# Painel do catálogo licenciado (/admin/titles): e-mails das contas administradoras, separados por vírgula.
ADMIN_EMAILS=

# Mux (https://dashboard.mux.com > Settings > Access Tokens, com permissão Mux Video "Read and Write").
# Com eles, o painel envia os arquivos de vídeo para o Mux, que converte para streaming HLS adaptativo.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Opcional, recomendado para filmes licenciados: chave de assinatura (Settings > Signing Keys).
# Com ela, os vídeos novos ficam privados e o player recebe links que vencem em 6 horas.
# MUX_SIGNING_KEY_PRIVATE é a chave privada em base64, como o Mux entrega (colada como PEM também vale).
# Os nomes do arquivo .env baixado do Mux (MUX_SIGNING_KEY e MUX_PRIVATE_KEY) também funcionam.
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=
# Qualidade de codificação: basic (padrão, sem custo de codificação) ou plus.
MUX_VIDEO_QUALITY=basic
